parameters:
    # The CI analyses only the files of the last commit (codestyle_check.sh). A baseline generated
    # over src/ cannot match such partial runs: errors of traits and errors that depend on the
    # other analysed files only show up in the full run. Stale entries are cleaned up by
    # regenerating the baseline (composer phpstan-generate-baseline).
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            identifier: missingType.iterableValue

    bootstrapFiles:
        - phpstan-bootstrap.php
    level: max
    treatPhpDocTypesAsCertain: false
    scanFiles:
        - ../../vendor/oxid-esales/oxideshop-ce/source/oxfunctions.php
        - ../../vendor/oxid-esales/oxideshop-ce/source/overridablefunctions.php
includes:
    - phpstan-baseline.neon
