<h1>Ala ma kota</h1>
{{ debug(getControllerName(oView)) }}

{% if getControllerName(oView) == 'OrderController' %}
    {% set payment = oView.getPayment() %}
    {% set paymentId = payment.getId() %}
    {% set sToken = oViewConf.getSessionChallengeToken() %}
    {% set sSelfLink = oViewConf.getSslSelfLink()|replace({'&amp;': '&'}) %}
    {% set purchaseUnits = oView.getPurchaseUnits() %}
    {% set vaultedPaymentSource = oView.getVaultedPaymentSource() %}
    {% set oPPconfig = oViewConf.getPayPalCheckoutConfig() %}
    {% set isSandBox = oPPconfig.isSandbox() %}
    {% set captureStrategy = oPPconfig.getPayPalStandardCaptureStrategy() %}

    {% if isSandBox %}
        {% set debug = '&XDEBUG_SESSION=PHPSTORM' %}
    {% else %}
        {% set debug = '' %}
    {% endif %}

    <script>
        const PayPalPaymentControllerConfiguratorDefaults = {
            shopOrderErrorUrl: '{{ sSelfLink ~ "cl=ajaxpay&fnc=logError&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
            shopOrderDeleteUrl: '{{ sSelfLink ~ "cl=ajaxpay&fnc=cancelShopOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
            payPalOrderDetailsUrl: '{{ sSelfLink ~ "cl=ajaxpay&fnc=fetchPayPalOrderDetails&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
            errorLogUrl: '{{ sSelfLink ~ "cl=payment&payerror=2&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
            shopThankYouPageUrl: '{{ sSelfLink ~ "cl=thankyou&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
            deliveryAddressId: '{{ oView.getDeliveryAddressMD5() }}',
            purchaseUnits: {{ purchaseUnits|raw }},
            vaultedPaymentSource: {{ vaultedPaymentSource|raw }},
            language: '{{ oView.getActiveLangAbbr()|lower }}',
            currency: '{{ currency.name }}'
        }

        {% if paymentId == 'oscpaypal' %}
        window.PayPalPaymentControllerConfigurator = function () {
            return Object.assign(PayPalPaymentControllerConfiguratorDefaults, {
                shopOrderCreateUrl: '{{ sSelfLink ~ "cl=ajaxpay&fnc=createShopOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
                shopOrderPatchingUrl: '{{ sSelfLink ~ "cl=ajaxpay&fnc=patchShopOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
                updateOxUserWithPayPalCustomerIdUrl: '{{ sSelfLink ~ "cl=ajaxpay&fnc=updateOxUserWithPayPalCustomerId&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
                buttonSelector: 'div#{{ paymentId }}',
                captureStrategy: '{% if captureStrategy == 'directly' %}CAPTURE{% else %}AUTHORIZE{% endif %}',
                paymentId: 'oscpaypal',
            });
        };
        {% endif %}

        {% if paymentId == 'oscpaypal_acdc' %}
        window.PayPalPaymentControllerConfigurator = function () {
            return Object.assign(PayPalPaymentControllerConfiguratorDefaults, {
                shopOrderCaptureUrl: '{{ sSelfLink ~ "cl=ajaxpay&fnc=captureOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
                shopOrderCreateUrl: '{{ sSelfLink ~ "cl=ajaxpay&fnc=createAcdcOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
                cardFields: true,
                paymentId: '{{ paymentId }}',
                buttonSelector: 'button#{{ paymentId }}'
            });
        };
        {% endif %}

        {% if paymentId == 'oscpaypal_googlepay' %}
        {% set bGooglePayDelivery = oConfig.getConfigParam('oscPayPalUseGooglePayAddress') %}

        window.PayPalPaymentControllerConfigurator = function () {
            return Object.assign(PayPalPaymentControllerConfiguratorDefaults, {
                finalizeGooglePayOrder: '{{ sSelfLink ~ "cl=order&fnc=finalizeGooglePay&paymentid=oscpaypal_googlepay&context=continue&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
                executeGooglePayOrder: '{{ sSelfLink ~ "cl=order&fnc=executeGooglePayOrder&paymentid=oscpaypal_googlepay&context=continue&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
                captureGooglePayOrder: '{{ sSelfLink ~ "cl=order&fnc=captureGooglePayOrder&paymentid=oscpaypal_googlepay&context=continue&aid=" ~ aid ~ "&stoken=" ~ sToken ~ "&sDeliveryAddressMD5=" ~ oView.getDeliveryAddressMD5() ~ debug | raw }}',
                googlePayOrderCreateUrl: '{{ sSelfLink ~ "cl=oscpaypalproxy&fnc=createGooglePayOrder&paymentid=oscpaypal_googlepay&context=continue&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',
                shopOrderCreateUrl: '{{ sSelfLink ~ "cl=ajaxpay&fnc=createShopOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug | raw }}',

                isSandbox: !!{{ isSandBox ? 'true' : 'false' }},
                useGooglePayAddress: !!'{{ bGooglePayDelivery }}',
                merchantName: '{{ oxcmp_shop.oxshops__oxname.value|escape('js') }}',
                totalPrice: '{{ oxcmp_basket.getPriceForPayment() }}',
                paymentId: '{{ paymentId }}',
                loadingContainer: 'google-pay-loading-container',
                buttonSelector: 'div#{{ paymentId }}'
            });
        };
        {% endif %}

        if ('undefined' !== typeof PayPalPaymentControllerConfigurator) {
            window.PayPalPaymentControllerConfig = new PayPalPaymentControllerConfigurator();
            document.dispatchEvent(
                new CustomEvent('PayPalPaymentControllerConfigCreated', {detail: window.PayPalPaymentControllerConfig})
            );
        }
    </script>
{% endif %}
