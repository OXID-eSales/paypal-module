{% if oViewConf.getTopActiveClassName() == 'order' %}
    {% set payment = oView.getPayment() %}
    {% set paymentId = payment.getId() %}
    {% set sToken = oViewConf.getSessionChallengeToken() %}
    {% set sSelfLink = oViewConf.getSslSelfLink()|replace({"&amp;": "&"}) %}
    {% set purchaseUnits = oView.getPurchaseUnits() %}
    {% set vaultedPaymentSource = oView.getVaultedPaymentSource() %}
    {% set oPPconfig = oViewConf.getPayPalCheckoutConfig() %}
    {% set customerId = oView.getPayPalCustomerId() %}
    {% set isSandBox = oPPconfig.isSandbox() %}
    {% set captureStrategy = oPPconfig.getPayPalStandardCaptureStrategy() %}
    {% set currency = oView.getActCurrency() %}

    {% if isSandBox %}
        {% set debug = '&XDEBUG_SESSION=PHPSTORM' %}
    {% else %}
        {% set debug = '' %}
    {% endif %}

    <script>
        const PayPalPaymentControllerConfiguratorDefaults = {
            shopOrderErrorUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=logError&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
            shopOrderCancelUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=cancelShopOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
            shopOrderFinalizeUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=finalizePayPalSession&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
            payPalOrderDetailsUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=fetchPayPalOrderDetails&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
            errorLogUrl: '{{ (sSelfLink ~ "cl=payment&payerror=2&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
            shopThankYouPageUrl: '{{ (sSelfLink ~ "cl=thankyou&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
            shopOrderAuthorizeUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=authorizePayment&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
            deliveryAddressId: '{{ oView.getDeliveryAddressMD5() }}',
            purchaseUnits: {{ purchaseUnits|raw }},
            vaultedPaymentSource: {{ vaultedPaymentSource|raw }},
            language: '{{ oView.getActiveLangAbbr()|lower }}',
            currency: '{{ currency.name }}',
            customerId: '{{ customerId }}',
            captureStrategy: '{% if captureStrategy == 'directly' %}CAPTURE{% else %}AUTHORIZE{% endif %}',
            trackingId: '{{ oView.getCurrentTrackingId() }}',
        };

        {% if paymentId == 'oscpaypal' %}
            window.PayPalPaymentControllerConfigurator = function () {
                return Object.assign(PayPalPaymentControllerConfiguratorDefaults, {
                    shopOrderCreateUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=createShopOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    payPalOrderCreateUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=createPayPalOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    shopOrderCaptureUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=captureOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    shopOrderPatchingUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=patchShopOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    updateOxUserWithPayPalCustomerIdUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=updateOxUserWithPayPalCustomerId&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    buttonSelector: '#{{ paymentId }}',
                    paymentId: 'oscpaypal'
                });
            };
        {% endif %}

        {% if paymentId == 'oscpaypal_acdc' %}
            window.PayPalPaymentControllerConfigurator = function () {
                return Object.assign(PayPalPaymentControllerConfiguratorDefaults, {
                    shopOrderCaptureUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=captureOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    shopOrderCreateUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=createAcdcOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    shopOrderCompleteUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=completeOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    cardFields: true, //probably not needed when payment controller will be split
                    paymentId: '{{ paymentId }}', //probably not needed when payment controller will be split
                    buttonSelector: 'button#{{ paymentId }}'
                });
            };
        {% endif %}

        {% if paymentId == 'oscpaypal_googlepay' %}
            {% set bGooglePayDelivery = oPPconfig.getIsGooglePayDeliveryAddressActive() %}

            window.PayPalPaymentControllerConfigurator = function () {
                return Object.assign(PayPalPaymentControllerConfiguratorDefaults, {
                    finalizeGooglePayOrder: '{{ (sSelfLink ~ "cl=order&fnc=finalizeGooglePay&paymentid=oscpaypal_googlepay&context=continue&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    executeGooglePayOrder: '{{ (sSelfLink ~ "cl=order&fnc=executeGooglePayOrder&paymentid=oscpaypal_googlepay&context=continue&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    captureGooglePayOrder: '{{ (sSelfLink ~ "cl=order&fnc=captureGooglePayOrder&paymentid=oscpaypal_googlepay&context=continue&aid=" ~ aid ~ "&stoken=" ~ sToken ~ "&sDeliveryAddressMD5=" ~ oView.getDeliveryAddressMD5() ~ debug)|replace({'&amp;': '&'})|raw }}',
                    googlePayOrderCreateUrl: '{{ (sSelfLink ~ "cl=oscpaypalproxy&fnc=createGooglePayOrder&paymentid=oscpaypal_googlepay&context=continue&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',
                    shopOrderCreateUrl: '{{ (sSelfLink ~ "cl=ajaxpay&fnc=createShopOrder&aid=" ~ aid ~ "&stoken=" ~ sToken ~ debug)|replace({'&amp;': '&'})|raw }}',

                    isSandbox: {{ isSandBox ? 'true' : 'false' }},
                    useGooglePayAddress: {{ bGooglePayDelivery ? 'true' : 'false' }},
                    merchantName: '{{ oxcmp_shop.oxshops__oxname.value|escape('js') }}',
                    totalPrice: '{{ oxcmp_basket.getPriceForPayment() }}',
                    paymentId: '{{ paymentId }}',
                    loadingContainer: 'google-pay-loading-container',
                    buttonSelector: 'div#{{ paymentId }}'
                });
            };
        {% endif %}

        if ('undefined' !== typeof PayPalPaymentControllerConfigurator) {
            window.PayPalPaymentControllerConfig = new PayPalPaymentControllerConfigurator();
            document.dispatchEvent(
                new CustomEvent('PayPalPaymentControllerConfigCreated', {detail: window.PayPalPaymentControllerConfig})
            );
        }
    </script>
{% endif %}
