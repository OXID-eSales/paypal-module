<!-- Advanced credit and debit card payments form -->
<div id="card_container" class="card_container">
    <div id="card_form">
        <div class="form-floating mb-3">
            <div id="card-number-field-container"></div>
        </div>
        <div class="form-floating mb-3">
            <div id="card-expiry-field-container"></div>
        </div>
        <div class="form-floating mb-3">
            <div id="card-cvv-field-container"></div>
        </div>
        <div class="form-floating mb-3">
            <div id="card-name-field-container"></div>
        </div>
        {% if oscpaypal_isVaultingPossible %}
            <input type="checkbox" id="oscPayPalVaultPaymentCheckbox" disabled>
            <label for="oscPayPalVaultPaymentCheckbox">{{ translate({ ident: "OSC_PAYPAL_VAULTING_SAVE" }) }}</label>
        {% endif %}
        <div class="hidden">
            <input type="hidden" id="card-billing-address-street" name="card-billing-address-street" value="{% if oxcmp_user.oxuser__oxstreet.value %}{{ oxcmp_user.oxuser__oxstreet.value }}{% endif %} {% if oxcmp_user.oxuser__oxstreetnr.value %}{{ oxcmp_user.oxuser__oxstreetnr.value }}{% endif %}" />
            <input type="hidden" id="card-billing-address-unit" name="card-billing-address-unit" value=""/>
            <input type="hidden" id="card-billing-address-city" name="card-billing-address-city" value="{% if oxcmp_user.oxuser__oxcity.value %}{{ oxcmp_user.oxuser__oxcity.value }}{% endif %}" />
            <input type="hidden" id="card-billing-address-state" name="card-billing-address-state" value="{{ oView.getUserStateIso() }}" />
            <input type="hidden" id="card-billing-address-zip" name="card-billing-address-zip" value="{% if oxcmp_user.oxuser__oxzip.value %}{{ oxcmp_user.oxuser__oxzip.value }}{% endif %}" />
            <input type="hidden" id="card-billing-address-country" name="card-billing-address-country" value="{{ oView.getUserCountryIso() }}"/>
        </div>
    </div>
</div>
