{% include "headitem.html.twig" with {title: "paypal", box: "boxpaypal"} %}
{% include "@osc_paypal/admin/admin_headitem_inccss.html.twig" %}
{% set isSandBox = config.isSandbox() %}
{% set sSelfLink = oViewConf.getSslSelfLink()|replace({"&amp;": "&"}) %}

{% set sPayPalJS %}
    window.isSandBox = '{{ isSandBox }}';
    window.selfLink = '{{ sSelfLink|raw }}';
{% endset %}
{{ script({ add: sPayPalJS.__toString(), priority: 10, dynamic: __oxid_include_dynamic }) }}

<form name="transfer" id="transfer" action="{{ oViewConf.getSelfLink()|raw }}" method="post">
    {{ oViewConf.getHiddenSid()|raw }}
    <input type="hidden" name="oxid" value="{{ oModule.getInfo('id') }}">
    <input type="hidden" name="cl" value="{{ oViewConf.getActiveClassName() }}">
    <input type="hidden" name="fnc" value="">
    <input type="hidden" name="actshop" value="{{ oViewConf.getActiveShopId() }}">
    <input type="hidden" name="updatenav" value="">
    <input type="hidden" name="editlanguage" value="{{ editlanguage }}">
</form>

<div id="content" class="paypal-config">
    <div class="alert alert-{% if Errors.paypal_error %}danger{% else %}success{% endif %}" role="alert">
        {% if Errors.paypal_error %}
        {{ translate({ ident: "OSC_PAYPAL_ERR_CONF_INVALID" }) }}
        {% else %}
        {{ translate({ ident: "OSC_PAYPAL_CONF_VALID" }) }}
        {% endif %}
    </div>
    <div id="paypal-overlay"><div class="loader"></div></div>
    <form id="configForm" name="configForm" action="{{ oViewConf.getSslSelfLink()|replace({'&amp;': '&'})|raw }}" method="post" autocomplete="off">
        {{ oViewConf.getHiddenSid()|raw }}
        <input type="hidden" name="cl" value="{{ oViewConf.getActiveClassName() }}">
        <input type="hidden" name="fnc" value="save">
        <input type="hidden" name="oxid" value="{{ oModule.getInfo('id') }}">

        <div id="accordion">
            <div class="card">
                <div class="card-header" id="heading1">
                    <h4 class="" data-toggle="collapse" data-target="#collapse1" aria-expanded="true" aria-controls="collapse1">
                        {{ translate({ ident: "OSC_PAYPAL_CREDENTIALS" }) }}
                    </h4>
                </div>

                <div id="collapse1" class="collapse show" aria-labelledby="heading1" data-parent="#accordion">
                    <div class="card-body">
                        <label for="opmode">{{ translate({ ident: "OSC_PAYPAL_OPMODE" }) }}</label>
                        <div class="controls">
                            <select name="conf[oscPayPalSandboxMode]" id="opmode" class="form-control">
                                <option value="sandbox" {% if config.isSandbox() %}selected{% endif %}>
                                    {{ translate({ ident: "OSC_PAYPAL_OPMODE_SANDBOX" }) }}
                                </option>
                                <option value="live" {% if not config.isSandbox() %}selected{% endif %}>
                                    {{ translate({ ident: "OSC_PAYPAL_OPMODE_LIVE" }) }}
                                </option>
                            </select>
                            <span class="help-block">{{ translate({ ident: "HELP_OSC_PAYPAL_OPMODE" }) }}</span>
                        </div>

                        <label>{{ translate({ ident: "OSC_PAYPAL_CREDENTIALS" }) }}</label>

                        <p class="help-block text-danger">{{ translate({ ident: "HELP_OSC_PAYPAL_CREDENTIALS_PART1" }) }}</p>
                        <p class="help-block text-danger">{{ translate({ ident: "HELP_OSC_PAYPAL_CREDENTIALS_PART2" }) }}</p>

                        <p class="live"><a target="_blank"
                                           class="popuplink2"
                                           href="{{ oView.getLiveSignUpMerchantIntegrationLink()|raw }}"
                                           id="paypalonboardinglive"
                                           data-paypal-onboard-complete="onboardedCallbackLive"
                                           data-paypal-button="PPLtBlue">
                                {{ translate({ ident: "OSC_PAYPAL_LIVE_BUTTON_CREDENTIALS" }) }}
                            </a>
                        </p>

                        <h3 class="live">{{ translate({ ident: "OSC_PAYPAL_LIVE_CREDENTIALS" }) }}</h3>

                        <div class="form-group live">
                            <label for="client-id">{{ translate({ ident: "OSC_PAYPAL_CLIENT_ID" }) }}</label>
                            <div class="controls">
                                <input type="text" class="form-control" id="client-id" name="conf[oscPayPalClientId]" value="{{ config.getLiveClientId() }}" />
                                <span class="help-block">{{ translate({ ident: "HELP_OSC_PAYPAL_CLIENT_ID" }) }}</span>
                            </div>
                        </div>

                        <div class="form-group live">
                            <label for="client-secret">{{ translate({ ident: "OSC_PAYPAL_CLIENT_SECRET" }) }}</label>
                            <div class="controls">
                                <input class="password_input form-control" type="password" name="conf[oscPayPalClientSecret]" data-empty="{% if config.getLiveClientSecret() %}false{% else %}true{% endif %}" data-errorMessage="{{ translate({ ident: "MODULE_PASSWORDS_DO_NOT_MATCH" }) }}" {{ readonly }} title="{{ translate({ ident: "MODULE_REPEAT_PASSWORD" }) }}" />
                                <span id="client-secret" class="help-block">{{ translate({ ident: "HELP_OSC_PAYPAL_CLIENT_SECRET" }) }}</span>
                            </div>
                        </div>

                        <div class="form-group live">
                            <label for="merchant-id">{{ translate({ ident: "OSC_PAYPAL_MERCHANT_ID" }) }}</label>
                            <div class="controls">
                                <input type="text" class="form-control" id="merchant-id" name="conf[oscPayPalClientMerchantId]" value="{{ config.getLiveMerchantId() }}" />
                                <span class="help-block">{{ translate({ ident: "HELP_OSC_PAYPAL_MERCHANT_ID" }) }}</span>
                            </div>
                        </div>

                        <div class="form-group live">
                            <label for="webhook-id">{{ translate({ ident: "OSC_PAYPAL_WEBHOOK_ID" }) }}</label>
                            <div class="controls">
                                <input type="text" class="form-control" id="webhook-id" name="conf[oscPayPalWebhookId]" value="{{ config.getLiveWebhookId() }}" />
                                <span class="help-block">{{ translate({ ident: "HELP_OSC_PAYPAL_WEBHOOK_ID" }) }}</span>
                            </div>
                        </div>

                        <div class="form-group live">
                            <label for="special-payments">{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS", suffix: "COLON" }) }}</label>
                            <ul>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_PUI", suffix: "COLON" }) }}</b>
                                    {% if config.isLivePuiEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_ACDC", suffix: "COLON" }) }}</b>
                                    {% if config.isLiveAcdcEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }} {{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_ACDC_FALLBACK" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_VAULTING", suffix: "COLON" }) }}</b>
                                    {% if config.isLiveVaultingEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_GOOGLEPAY", suffix: "COLON" }) }}</b>
                                    {% if config.isLiveGooglePayEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_APPLEPAY", suffix: "COLON" }) }}</b>
                                    {% if config.isLiveApplePayEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }} {{ translate({ ident: "OSC_PAYPAL_INSTALL_NOTE_APPLEPAY" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_EPS", suffix: "COLON" }) }}</b>
                                    {% if config.isLiveEpsEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_PRZELEWY24", suffix: "COLON" }) }}</b>
                                    {% if config.isLivePrzelewy24Eligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_BLIK", suffix: "COLON" }) }}</b>
                                    {% if config.isLiveBlikEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_BANCONTACT", suffix: "COLON" }) }}</b>
                                    {% if config.isLiveBanContactEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_IDEAL", suffix: "COLON" }) }}</b>
                                    {% if config.isLiveIDealEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                {# SEPA unbranded comming soon
                                    <li>
                                        <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_SEPA", suffix: "COLON" }) }}</b>
                                        {% if config.isLiveSepaEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                    </li>
                                #}
                            </ul>
                        </div>

                        <p class="sandbox"><a target="_blank"
                                              class="popuplink"
                                              href="{{ oView.getSandboxSignUpMerchantIntegrationLink()|raw }}"
                                              id="paypalonboardingsandbox"
                                              data-paypal-onboard-complete="onboardedCallbackSandbox"
                                              data-paypal-button="PPLtBlue">
                                {{ translate({ ident: "OSC_PAYPAL_SANDBOX_BUTTON_CREDENTIALS" }) }}
                            </a>
                        </p>

                        <h3 class="sandbox">{{ translate({ ident: "OSC_PAYPAL_SANDBOX_CREDENTIALS" }) }}</h3>

                        <div class="form-group sandbox">
                            <label for="client-sandbox-id">{{ translate({ ident: "OSC_PAYPAL_CLIENT_ID" }) }}</label>
                            <div class="controls">
                                <input type="text" class="form-control" id="client-sandbox-id" name="conf[oscPayPalSandboxClientId]" value="{{ config.getSandboxClientId() }}" />
                                <span class="help-block">{{ translate({ ident: "HELP_OSC_PAYPAL_SANDBOX_CLIENT_ID" }) }}</span>
                            </div>
                        </div>

                        <div class="form-group sandbox">
                            <label for="client-sandbox-secret">{{ translate({ ident: "OSC_PAYPAL_CLIENT_SECRET" }) }}</label>
                            <div class="controls">
                                <input class="password_input form-control" type="password" name="conf[oscPayPalSandboxClientSecret]" data-empty="{% if config.getSandboxClientSecret() %}false{% else %}true{% endif %}" data-errorMessage="{{ translate({ ident: "MODULE_PASSWORDS_DO_NOT_MATCH" }) }}" {{ readonly }} title="{{ translate({ ident: "MODULE_REPEAT_PASSWORD" }) }}" />
                                <span id="client-sandbox-secret" class="help-block">{{ translate({ ident: "HELP_OSC_PAYPAL_SANDBOX_CLIENT_SECRET" }) }}</span>
                            </div>
                        </div>

                        <div class="form-group sandbox">
                            <label for="merchant-sandbox-id">{{ translate({ ident: "OSC_PAYPAL_MERCHANT_ID" }) }}</label>
                            <div class="controls">
                                <input type="text" class="form-control" id="merchant-sandbox-id" name="conf[oscPayPalSandboxClientMerchantId]" value="{{ config.getSandboxMerchantId() }}" />
                                <span class="help-block">{{ translate({ ident: "HELP_OSC_PAYPAL_SANDBOX_MERCHANT_ID" }) }}</span>
                            </div>
                        </div>

                        <div class="form-group sandbox">
                            <label for="webhook-sandbox-id">{{ translate({ ident: "OSC_PAYPAL_WEBHOOK_ID" }) }}</label>
                            <div class="controls">
                                <input type="text" class="form-control" id="webhook-sandbox-id" name="conf[oscPayPalSandboxWebhookId]" value="{{ config.getSandboxWebhookId() }}" />
                                <span class="help-block">{{ translate({ ident: "HELP_OSC_PAYPAL_SANDBOX_WEBHOOK_ID" }) }}</span>
                            </div>
                        </div>

                        <div class="form-group sandbox">
                            <label for="special-payments-sandbox">{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS", suffix: "COLON" }) }}</label>
                            <ul>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_PUI", suffix: "COLON" }) }}</b>
                                    {% if config.isSandboxPuiEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_ACDC", suffix: "COLON" }) }}</b>
                                    {% if config.isSandboxAcdcEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }} {{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_ACDC_FALLBACK" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_VAULTING", suffix: "COLON" }) }}</b>
                                    {% if config.isSandboxVaultingEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_GOOGLEPAY", suffix: "COLON" }) }}</b>
                                    {% if config.isSandboxGooglePayEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_APPLEPAY", suffix: "COLON" }) }}</b>
                                    {% if config.isSandboxApplePayEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }} {{ translate({ ident: "OSC_PAYPAL_INSTALL_NOTE_APPLEPAY" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_EPS", suffix: "COLON" }) }}</b>
                                    {% if config.isSandboxEpsEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_PRZELEWY24", suffix: "COLON" }) }}</b>
                                    {% if config.isSandboxPrzelewy24Eligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_BLIK", suffix: "COLON" }) }}</b>
                                    {% if config.isSandboxBlikEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_BANCONTACT", suffix: "COLON" }) }}</b>
                                    {% if config.isSandboxBanContactEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                <li>
                                    <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_IDEAL", suffix: "COLON" }) }}</b>
                                    {% if config.isSandboxIDealEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                </li>
                                {# SEPA unbranded comming soon
                                    <li>
                                        <b>{{ translate({ ident: "OSC_PAYPAL_SPECIAL_PAYMENTS_SEPA", suffix: "COLON" }) }}</b>
                                        {% if config.isSandboxSepaEligibility() %}{{ translate({ ident: "GENERAL_YES" }) }}{% else %}{{ translate({ ident: "GENERAL_NO" }) }}{% endif %}
                                    </li>
                                #}
                            </ul>
                        </div>

                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header" id="heading2">
                    <h4 class="collapsed" data-toggle="collapse" data-target="#collapse2" aria-expanded="false" aria-controls="collapse2">
                        {{ translate({ ident: "OSC_PAYPAL_BUTTON_PLACEMEMT_TITLE" }) }}
                    </h4>
                </div>

                <div id="collapse2" class="collapse" aria-labelledby="heading2" data-parent="#accordion">
                    <div class="card-body">
                        <div class="form-group">
                            <div class="controls">
                                <p><span class="help-block">{{ translate({ ident: "HELP_OSC_PAYPAL_BUTTON_PLACEMEMT" }) }}</span></p>
                                <div>
                                    <div class="checkbox">
                                        <label>
                                            <input type="checkbox" name="conf[oscPayPalShowProductDetailsButton]" {% if config.showPayPalProductDetailsButton() %}checked{% endif %} value="1">
                                            {{ translate({ ident: "OSC_PAYPAL_PRODUCT_DETAILS_BUTTON_PLACEMENT" }) }}
                                        </label>
                                    </div>
                                    <div class="checkbox">
                                        <label>
                                            <input type="checkbox" name="conf[oscPayPalShowBasketButton]" {% if config.showPayPalBasketButton() %}checked{% endif %} value="1">
                                            {{ translate({ ident: "OSC_PAYPAL_BASKET_BUTTON_PLACEMENT" }) }}
                                        </label>
                                    </div>
                                    <div class="checkbox">
                                        <label>
                                            <input type="checkbox" name="conf[oscPayPalShowMiniBasketButton]" {% if config.showPayPalMiniBasketButton() %}checked{% endif %} value="1">
                                            {{ translate({ ident: "OSC_PAYPAL_MINIBASKET_BUTTON_PLACEMENT" }) }}
                                        </label>
                                    </div>
                                </div>
                                <p><span class="help-block">{{ translate({ ident: "HELP_OSC_SHOW_PAYPAL_PAYLATER_BUTTON" }) }}</span></p>
                                <div>
                                    <div class="checkbox">
                                        <label>
                                            <input type="checkbox" name="conf[oscPayPalShowPayLaterButton]" {% if config.showPayPalPayLaterButton() %}checked{% endif %} value="1">
                                            {{ translate({ ident: "OSC_SHOW_PAYPAL_PAYLATER_BUTTON" }) }}
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header" id="heading10">
                  <h4 class="collapsed" data-toggle="collapse" data-target="#collapse_button_style" aria-expanded="false" aria-controls="collapse_button_style">
                    {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_TITLE" }) }}
                    </h4>
                </div>

                <div id="collapse_button_style" class="collapse" aria-labelledby="heading10" data-parent="#accordion">
                    <div class="card-body">
                        <div class="form-group">
                            <label for="style-button-layout">{{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_LAYOUT" }) }}</label>
                            <div class="controls">
                                <select name="conf[oscPayPalButtonStyleLayout]" id="style-button-layout" class="form-control">
                                    <option value="horizontal" {% if config.getPayPalButtonStyleLayout() == 'horizontal' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_LAYOUT_HORIZONTAL" }) }}
                                    </option>
                                    <option value="vertical" {% if config.getPayPalButtonStyleLayout() == 'vertical' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_LAYOUT_VERTICAL" }) }}
                                    </option>
                                </select>
                            </div>
                            <span class="help-block">{{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_LAYOUT_HELP" }) }}</span>
                        </div>
                        <div class="form-group">
                            <label for="style-button-color">{{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_COLOR" }) }}</label>
                            <div class="controls">
                                <select name="conf[oscPayPalButtonStyleColor]" id="style-button-color" class="form-control">
                                    <option value="gold" {% if config.getPayPalButtonStyleColor() == 'gold' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_COLOR_GOLD" }) }}
                                    </option>
                                    <option value="blue" {% if config.getPayPalButtonStyleColor() == 'blue' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_COLOR_BLUE" }) }}
                                    </option>
                                    <option value="silver" {% if config.getPayPalButtonStyleColor() == 'silver' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_COLOR_SILVER" }) }}
                                    </option>
                                    <option value="white" {% if config.getPayPalButtonStyleColor() == 'white' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_COLOR_WHITE" }) }}
                                    </option>
                                    <option value="black" {% if config.getPayPalButtonStyleColor() == 'black' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_COLOR_BLACK" }) }}
                                    </option>
                                </select>
                            </div>
                            <span class="help-block">{{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_COLOR_HELP" }) }}</span>
                        </div>
                        <div class="form-group">
                            <label for="style-button-shape">{{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_SHAPE" }) }}</label>
                            <div class="controls">
                                <select name="conf[oscPayPalButtonStyleShape]" id="style-button-shape" class="form-control">
                                    <option value="rect" {% if config.getPayPalButtonStyleShape() == 'rect' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_SHAPE_RECT" }) }}
                                    </option>
                                    <option value="sharp" {% if config.getPayPalButtonStyleShape() == 'sharp' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_SHAPE_SHARP" }) }}
                                    </option>
                                    <option value="pill" {% if config.getPayPalButtonStyleShape() == 'pill' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_SHAPE_PILL" }) }}
                                    </option>
                                </select>
                            </div>
                            <span class="help-block">{{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_SHAPE_HELP" }) }}</span>
                        </div>
                        <div class="form-group">
                            <label for="style-button-label">{{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_LABEL" }) }}</label>
                            <div class="controls">
                                <select name="conf[oscPayPalButtonStyleLabel]" id="style-button-label" class="form-control">
                                    <option value="paypal" {% if config.getPayPalButtonStyleLabel() == 'paypal' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_LABEL_PAYPAL" }) }}
                                    </option>
                                    <option value="checkout" {% if config.getPayPalButtonStyleLabel() == 'checkout' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_LABEL_CHECKOUT" }) }}
                                    </option>
                                    <option value="buynow" {% if config.getPayPalButtonStyleLabel() == 'buynow' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_LABEL_BUYNOW" }) }}
                                    </option>
                                    <option value="pay" {% if config.getPayPalButtonStyleLabel() == 'pay' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_LABEL_PAY" }) }}
                                    </option>
                                    {#
                                    <option value="installment" {% if config.getPayPalButtonStyleLabel() == 'installment' %}selected{% endif %}>
                                        {{ translate({ ident: "OSC_PAYPAL_STYLE_BUTTON_LABEL_INSTALLMENT" }) }}
                                    </option>
                                    #}
                                </select>

                            </div>
