{% extends "headitem.html.twig" %}

{% block admin_headitem_inccss %}
    {% if (
        oViewConf.getTopActiveClassName()|lower == "module_config" and oModule.getInfo('id') == 'osc_paypal'
        ) or oViewConf.getTopActiveClassName()|lower == "oscpaypalorder"
    %}
        <link rel="stylesheet" type="text/css" href="{{ oViewConf.getModuleUrl('osc_paypal','src/css/bootstrap.min.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ oViewConf.getModuleUrl('osc_paypal','src/css/paypal-admin.min.css') }}">
    {% endif %}
    {{ parent() }}
{% endblock %}
