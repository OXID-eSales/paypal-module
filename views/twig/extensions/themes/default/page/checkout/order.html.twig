{% extends "page/checkout/order.html.twig" %}

{% block shippingAndPayment %}
    {% set sSelfLink = oViewConf.getSslSelfLink()|replace({'&amp;': '&'})|raw %}
    {% set payment = oView.getPayment() %}
    {% set paymentId = oView.getPayment().getId() %}
    {% if paymentId in ['oscpaypal_acdc', 'oscpaypal_pui', 'oscpaypal'] or vaultedPaymentDescription %}
        <form action="{{ sSelfLink }}" method="post"
              id="orderShipping">
            {{ oViewConf.getHiddenSid()|raw }}
            <input type="hidden" name="cl" value="payment">
            <input type="hidden" name="fnc" value="">
            <h4 class="card-header card-title card-header-edit d-flex justify-content-between align-items-center">
                {{ translate({ ident: "SHIPPING_CARRIER" }) }}
                <button type="submit" class="btn"
                        title="{{ translate({ ident: "EDIT" }) }}">
                    <svg aria-hidden="true">
                        <use xlink:href="#pencil"></use>
                    </svg>
                </button>
            </h4>
            {% set oShipSet = oView.getShipSet() %}
            <div class="card-body">
                {{ oShipSet.oxdeliveryset__oxtitle.value }}
            </div>
        </form>
        <form action="{{ oViewConf.getSslSelfLink()|replace({'&amp;': '&'})|raw }}" method="post"
              id="orderPayment">
            {{ oViewConf.getHiddenSid()|raw }}
            <input type="hidden" name="cl" value="payment">
            <input type="hidden" name="fnc" value="">
            <h4 class="card-header card-title card-header-edit d-flex justify-content-between align-items-center">
                {{ translate({ ident: "PAYMENT_METHOD" }) }}
                <button type="submit" class="btn"
                        title="{{ translate({ ident: "EDIT" }) }}">
                    <svg aria-hidden="true">
                        <use xlink:href="#pencil"></use>
                    </svg>
                </button>
            </h4>
        </form>
        <div class="card-body">
            {% if vaultedPaymentDescription %}
                {{ vaultedPaymentDescription }}
            {% else %}
                {{ payment.oxpayments__oxdesc.value }}
                {% if paymentId == "oscpaypal_acdc" %}
                    {% include "@osc_paypal/frontend/acdc.html.twig" %}
                {% elseif paymentId == "oscpaypal_pui" %}
                    {% include "@osc_paypal/frontend/pui.html.twig" %}
                {% elseif paymentId == "oscpaypal" %}
                    {% include "@osc_paypal/frontend/paypal.html.twig" %}
                {% endif %}
            {% endif %}
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block checkout_order_next_step_side %}
    {% set payment = oView.getPayment() %}
    {% set paymentId = oView.getPayment().getId() %}
    {% set oConfig = oViewConf.getConfig() %}
    {% set PayPalSDKJS = oConfig.getGlobalParameter("PayPalSDKJS") %}
    {% if not PayPalSDKJS %}
        {% set PayPalSDKJS %}
            {% set commitFlow = false %}
            {% if "oscpaypal" == paymentId %}
                {% set commitFlow = true %}
            {% endif %}
            {% include "@osc_paypal/frontend/base_js.html.twig" with {'commitFlow': commitFlow} %}
        {% endset %}
        {{ oConfig.setGlobalParameter("PayPalSDKJS", PayPalSDKJS) }}
    {% endif %}
    {% if paymentId == "oscpaypal_googlepay" %}
        {# google pay has a specific button #}
        {% include "@osc_paypal/frontend/googlepay_button.html.twig" %}
    {% elseif paymentId == "oscpaypal_applepay"%}
        {# apple pay has a specific button #}
        {% include "@osc_paypal/frontend/applepay_button.html.twig" with {paymentId: payment.getId()} %}
    {% else %}
        {% if paymentId == "oscpaypal_acdc" %}
            <button id="{{ paymentId }}" type="button" class="btn btn-lg btn-primary pull-right submitButton nextStep largeButton">
                <i class="fa fa-check"></i> {{ translate({ ident: "SUBMIT_ORDER" }) }}
            </button>
        {% elseif paymentId == "oscpaypal" %}
            {% if vaultedPaymentDescription %}
                <button id="{{ paymentId }}" type="button" class="btn btn-lg btn-primary float-right pull-right submitButton nextStep largeButton">
                    <i class="fa fa-check"></i> {{ translate({ ident: "SUBMIT_ORDER" }) }}
                </button>
            {% else %}
                <div id="{{ paymentId }}" class="paypal-button-container float-right pull-right"></div>
            {% endif %}
        {% else %}
            {{ parent() }}
        {% endif %}
    {% endif %}
    {% if paymentId == "oscpaypal_express" %}
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Apex (Twig) renders the submit-button as an OXID-standard
                // [onclick*="orderConfirmAgbBottom"] anchor in the parent block;
                // Wave/Flow expose .submitButton.nextStep. Cover both so the
                // hardening is theme-independent.
                var buttons = document.querySelectorAll(
                    '.submitButton.nextStep, [type="submit"].nextStep, [onclick*="orderConfirmAgbBottom"]'
                );
                var submitting = false;

                function lock(ev) {
                    if (submitting) {
                        if (ev) {
                            ev.preventDefault();
                            ev.stopImmediatePropagation();
                        }
                        return;
                    }
                    submitting = true;
                    for (var i = 0; i < buttons.length; i++) {
                        var b = buttons[i];
                        b.setAttribute('aria-busy', 'true');
                        b.setAttribute('aria-disabled', 'true');
                        if (!b.dataset.oscOriginalLabel) {
                            b.dataset.oscOriginalLabel = b.innerHTML;
                            b.innerHTML = '{{ translate({ ident: "OSC_PAYPAL_ORDER_SUBMITTING" }) }}';
                        }
                        // 1-tick delay: the native submit / OXID-JS click action
                        // must dispatch before disabled flips form-data inclusion
                        // for the submit button.
                        (function (btn) {
                            setTimeout(function () { btn.disabled = true; }, 0);
                        }(b));
                    }
                }

                for (var i = 0; i < buttons.length; i++) {
                    // Click covers: native type="submit", OXID-JS-driven
                    // form.submit() / inline onclick handler, and Enter key
                    // (browser dispatches synthetic click on the submit button).
                    // Capture phase + stopImmediatePropagation on the second event
                    // so we win against any other registered handler.
                    buttons[i].addEventListener('click', lock, true);
                    // Mobile: block the second tap before its synthetic click fires.
                    buttons[i].addEventListener('touchstart', function (ev) {
                        if (submitting) {
                            ev.preventDefault();
                            ev.stopImmediatePropagation();
                        }
                    }, { capture: true, passive: false });
                }

                // BFCache restore — unlock on Back-button reload so the customer
                // does not land on a frozen "submitting…" button.
                window.addEventListener('pageshow', function (ev) {
                    if (!ev.persisted) return;
                    submitting = false;
                    for (var i = 0; i < buttons.length; i++) {
                        var b = buttons[i];
                        b.disabled = false;
                        b.removeAttribute('aria-busy');
                        b.removeAttribute('aria-disabled');
                        if (b.dataset.oscOriginalLabel) {
                            b.innerHTML = b.dataset.oscOriginalLabel;
                            delete b.dataset.oscOriginalLabel;
                        }
                    }
                });
            });
        </script>
    {% endif %}
{% endblock %}
