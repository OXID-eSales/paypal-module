{
    "name": "oxid-solution-catalysts/paypal-module",
    "description": "OXID eSales PayPal payment module for OXID",
    "type": "oxideshop-module",
    "keywords": ["oxid", "modules", "eShop", "paypal", "payment"],
    "homepage": "https://www.oxid-esales.com",
    "license": ["GPL-3.0"],
    "support": {
        "source": "https://github.com/OXID-eSales/paypal-module",
        "issues": "https://github.com/OXID-eSales/paypal-module/issues",
        "forum": "https://forum.oxid-esales.com",
        "docs": "https://docs.oxid-esales.com/modules/paypal-checkout/en/latest"
    },
    "require": {
        "php": ">=8.0",
        "viison/address-splitter": "^0.3.4",
        "symfony/filesystem": "^6.4 || ^7.0",
        "brick/phonenumber": "^0.5.0",
        "guzzlehttp/guzzle": "~7",
        "psr/log": "^1.1",
        "league/oauth2-client": "^2.4",
        "webmozart/assert": "^1.7 || ^1.8 || ^1.9"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.0",
        "codeception/module-db": "^3.0",
        "codeception/module-filesystem": "^3.0",
        "codeception/module-webdriver": "^4.0",
        "composer/composer": "^2.0",
        "incenteev/composer-parameter-handler": "^v2.1.4",
        "mikey179/vfsstream": "~1.6.8",
        "oxid-esales/codeception-modules": "dev-b-7.4.x",
        "oxid-esales/codeception-page-objects": "dev-b-7.4.x",
        "oxid-esales/developer-tools": "dev-b-7.4.x",
        "oxid-esales/oxideshop-ide-helper": "dev-b-7.4.x",
        "oxid-esales/oxideshop-ce": "dev-b-7.4.x",
        "phpspec/prophecy-phpunit": "^v2.0.1",
        "phpunit/phpunit": "^11.4",
        "squizlabs/php_codesniffer": "^3.5.4",
        "phpstan/phpstan": "^1.10",
        "phpmd/phpmd": "^2.15"
    },
    "conflicts": {
        "oxid-esales/oxideshop-ce": "<7.4"
    },
    "autoload": {
        "psr-4": {
            "OxidSolutionCatalysts\\PayPal\\": "src/",
            "OxidSolutionCatalysts\\PayPalApi\\": "src/PayPalApi/",
            "OxidSolutionCatalysts\\PayPal\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpmd": "./.github/scripts/codestyle_check.sh phpmd",
        "phpmd-commit": "./.github/scripts/codestyle_check.sh phpmd commit",
        "phpstan": "./.github/scripts/codestyle_check.sh phpstan",
        "phpstan-commit": "./.github/scripts/codestyle_check.sh phpstan commit",
        "phpcs": "./.github/scripts/codestyle_check.sh phpcs",
        "phpcs-commit": "./.github/scripts/codestyle_check.sh phpcs commit",
        "style": "./.github/scripts/codestyle_check.sh all",
        "style-commit":  "./.github/scripts/codestyle_check.sh all commit",
        "phpcbf": "phpcbf --standard=tests/phpcs.xml",
        "static": [
            "@phpcs",
            "@phpstan",
            "@phpmd"
        ],
        "phpunit": "XDEBUG_MODE=coverage vendor/bin/phpunit -c tests/phpunit.xml --bootstrap=/var/www/source/bootstrap.php    --verbose",

        "generate-reports": [
            "@phpstan-report",
            "@phpmd-report"
        ],
        "generate-baselines": [
            "@phpstan-generate-baseline",
            "@phpmd-generate-baseline"
        ]
    },

    "config": {
        "allow-plugins": {
            "oxid-esales/oxideshop-unified-namespace-generator": true,
            "oxid-esales/oxideshop-composer-plugin": true
        }
    }
}
